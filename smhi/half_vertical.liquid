{%- assign hours = "09, 15" | split: ", " -%}
{%- assign show = 4 -%}
{%- assign type = ", Snö, Snöbland, Regn, Dugg, Undk regn, Undk dugg" | split: ", " -%}
{%- assign symbol = ", Klar himmel, Nästan klar himmel, Varierande molnighet, Halvklart, Molnig himmel, Mulet, Dimma, Lätta regnskurar, Måttliga regnskurar, Kraftiga regnskurar, Åskväder, Lätta snöslaskskurar, Måttliga snöslaskskurar, Kraftiga snöslaskskurar, Lätta snöbyar, Måttliga snöbyar, Kraftiga snöbyar, Lätt regn, Måttligt regn, Kraftigt regn, Åska, Lätt snöslask, Måttlig snöslask, Kraftig snöslask, Lätt snöfall, Måttligt snöfall, Kraftigt snöfall" | split: ", " -%}
{%- assign days_l = ", Måndag, Tisdag, Onsdag, Torsdag, Fredag, Lördag, Söndag" | split: ", " -%}
{%- assign days = ", Mån, Tis, Ons, Tors, Fre, Lör, Sön" | split: ", " -%}
{%- assign i = 0 -%}

{%- for series in timeSeries -%}
  {%- assign validtimetz = series.time | date: "%s" | plus: trmnl.user.utc_offset -%}
  {%- assign temp = series.data.air_temperature | round -%}
  {%- assign wind = series.data.wind_speed | round -%}
  {%- assign gust = series.data.wind_speed_of_gust | round -%}
  {%- assign precip = series.data.precipitation_amount_mean -%}
  {%- assign humid = series.data.relative_humidity -%}
  {%- assign pcat = type[series.data.predominant_precipitation_type_at_surface] -%}
  {%- assign wsymb = symbol[series.data.symbol_code] -%}
  {%- break -%}
{%- endfor -%}
{%- assign day_u = validtimetz | date: "%u" | plus: 0 -%}
{%- assign day = days_l[day_u] -%}
<div class="title_bar">
  <span class="title">{{ day }} {{ validtimetz | date: "%H:%M" }}</span>
  <span class="instance">{{ wsymb }}</span>
</div>

<div class="layout layout--col">
  <div class="grid grid--cols-2 stretch-y">
    <div class="item">
      <div class="content flex flex--center-x">
        <span class="value value--tnums lg:value--large">{{ temp }}°</span>
        <span class="label lg:label--large">Temp °C</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content flex flex--center-x">
        <span class="value value--tnums lg:value--large">{{ precip }}</span>
        <span class="label lg:label--large">{{ pcat | default: "Nederbörd"}} mm</span>
      </div>
    </div>
    <div class="item">
      <div class="content flex flex--center-x">
        <span class="value value--tnums lg:value--large">{{ wind }}–{{ gust }}</span>
        <span class="label lg:label--large">Vind m/s</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content flex flex--center-x">
        <span class="value value--tnums lg:value--large">{{ humid }}</span>
        <span class="label lg:label--large">Luftfuktighet %</span>
      </div>
    </div>
  </div>

  <div class="grid grid--cols-{{ show }}">
    {%- for series in timeSeries -%}
      {%- assign validtimetz = series.time | date: "%s" | plus: trmnl.user.utc_offset -%}
      {%- assign hour = validtimetz | date: "%H" -%}
      {%- if hours contains hour -%}
        {%- assign i = i | plus: 1 -%}
        {%- assign temp = series.data.air_temperature | round -%}
        {%- assign wind = series.data.wind_speed | round -%}
        {%- assign gust = series.data.wind_speed_of_gust | round -%}
        {%- assign precip = series.data.precipitation_amount_mean -%}
        {%- assign humid = series.data.relative_humidity -%}
        {%- assign pcat = type[series.data.predominant_precipitation_type_at_surface] -%}
        {%- assign day_u = validtimetz | date: "%u" | plus: 0 -%}
        {%- assign day = days[day_u] -%}
        <div class="flex flex--col flex--left">
          <div class="label label--small lg:label--base label--inverted">{{ day }} {{ validtimetz | date: "%H:%M" }}</div>
          <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ temp }}°C</div>
          <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ precip }}mm</div>
          <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ wind }}–{{ gust }}m/s</div>
          <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ humid }}%</div>
          <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ pcat | default: "–" }}</div>
        </div>
        {%- if i == show %}{% break %}{% endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<div class="title_bar">
  <span class="title">SMHI</span>
  <span class="instance">{{ trmnl.plugin_settings.custom_fields_values.city }}</span>
</div>
