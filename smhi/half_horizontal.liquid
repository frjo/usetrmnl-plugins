{%- assign hours = "08, 11, 15" | split: ", " -%}
{%- assign show = 6 -%}
{%- assign type = ", Regn, Åskväder, Undk regn, Isblandat, Snö, Blötsnö, Snöbland, Småhagel, Mjukhagel, Hagel, Dugg, Undk dugg " | split: ", " -%}
{%- assign symbol = ", Klar himmel, Nästan klar himmel, Varierande molnighet, Halvklart, Molnig himmel, Mulet, Dimma, Lätta regnskurar, Måttliga regnskurar, Kraftiga regnskurar, Åskväder, Lätta snöslaskskurar, Måttliga snöslaskskurar, Kraftiga snöslaskskurar, Lätta snöbyar, Måttliga snöbyar, Kraftiga snöbyar, Lätt regn, Måttligt regn, Kraftigt regn, Åska, Lätt snöslask, Måttlig snöslask, Kraftig snöslask, Lätt snöfall, Måttligt snöfall, Kraftigt snöfall" | split: ", " -%}
{%- assign days_l = ", Måndag, Tisdag, Onsdag, Torsdag, Fredag, Lördag, Söndag" | split: ", " -%}
{%- assign days = ", Mån, Tis, Ons, Tors, Fre, Lör, Sön" | split: ", " -%}
{%- assign i = 0 -%}

<div class="layout layout--col">
  <div class="grid grid--cols-{{ show | plus: 1 }}">
    {%- for series in timeSeries -%}
      {%- assign validtimetz = series.time | date: "%s" | plus: trmnl.user.utc_offset -%}
      {%- assign hour = validtimetz | date: "%H" -%}
      {%- if hours contains hour or forloop.first -%}
        {%- assign i = i | plus: 1 -%}
        {%- assign temp = series.data.air_temperature | round -%}
        {%- assign wind = series.data.wind_speed | round -%}
        {%- assign gust = series.data.wind_speed_of_gust | round -%}
        {%- assign precip = series.data.precipitation_amount_mean | replace: ".", "," -%}
        {%- assign pprob = series.data.probability_of_precipitation | replace: ".", "," -%}
        {%- assign pcat = type[series.data.predominant_precipitation_type_at_surface] -%}
        {%- assign wsymb = symbol[series.data.symbol_code] -%}
        {%- assign day_u = validtimetz | date: "%u" | plus: 0 -%}
        {%- assign day = days[day_u] -%}
        {%- if forloop.first -%}
          <div class="col--span-2">
            <div class="grid grid--cols-2">
              <div class="col--span-2 item">
                <div class="content flex flex--col flex--left">
                  <span class="value value--xxsmall lg:value--small">{{ wsymb }}</span>
                </div>
              </div>
              <div class="item">
                <div class="content flex flex--col flex--left">
                  <span class="value lg:value--large value--tnums">{{ temp }}°</span>
                  <span class="label label--small lg:label--large">Temp °C</span>
                </div>
              </div>
              <div class="item">
                <div class="content flex flex--col flex--left">
                  <span class="value value--xsmall lg:value--medium value--tnums">{{ precip }}</span>
                  <span class="label label--small lg:label--large">{{ pcat | default: "Nederbörd"}} mm</span>
                  <span class="value value--xsmall lg:value--medium value--tnums">{{ wind }} <span class="text--gray-40">({{ gust }})</span></span>
                  <span class="label label--small lg:label--large">Vind m/s</span>
                </div>
                <div class="meta"></div>
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="flex flex--col flex--left">
            <div class="label label--small lg:label--base label--primary">{{ day }} {{ validtimetz | date: "%H:%M" }}</div>
            <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ temp }}°C</div>
            <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ wind }} <span class="text--gray-40">({{ gust }})</span> m/s</div>
            <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ precip }}mm</div>
            <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ pprob }}%</div>
            <div class="value value--xxsmall lg:value--xsmall value--tnums">{{ pcat | default: "…" }}</div>
          </div>
        {%- endif -%}
        {%- if i == show %}{% break %}{% endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- for series in timeSeries -%}
  {%- assign validtimetz = series.time | date: "%s" | plus: trmnl.user.utc_offset -%}
  {%- break -%}
{%- endfor -%}
{%- assign day_u = validtimetz | date: "%u" | plus: 0 -%}
{%- assign day = days_l[day_u] -%}
<div class="title_bar">
  <span class="title">SMHI {{ day }} {{ validtimetz | date: "%Y-%m-%d %H:%M" }}</span>
  <span class="instance">{{ trmnl.plugin_settings.custom_fields_values.city }}</span>
</div>
